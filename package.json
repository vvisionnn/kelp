{
	"name": "kelp",
	"version": "0.0.0",
	"private": true,
	"description": "A modern, motion-rich console for SeaweedFS",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"dev:web": "vite",
		"dev:server": "bun --watch server/main.ts",
		"stack": "bun run scripts/stack.ts",
		"seed": "bun scripts/seed.ts",
		"build": "vite build",
		"start": "bun server/main.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "tsr generate && bun test ./server ./shared ./scripts && bun --config=bunfig.web.toml test ./src",
		"coverage": "tsr generate && bun test --coverage ./server ./shared ./scripts && bun --config=bunfig.web.toml test --coverage ./src",
		"e2e": "playwright test",
		"check": "bun run lint && bun run typecheck && bun run coverage && bun run build",
		"release": "bun scripts/release.ts",
		"routes": "tsr generate",
		"build:server": "bun build server/main.ts --target bun --outfile build/server.js",
		"compose:smoke": "bun scripts/compose-smoke.ts",
		"review": "bun scripts/review.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@grpc/grpc-js": "^1.14.7",
		"@grpc/proto-loader": "^0.8.1",
		"@headless-tree/core": "^1.8.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.105.3",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-table": "^9.3.1",
		"@tanstack/react-virtual": "^3.14.26",
		"avsc": "^5.7.9",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.5.2",
		"hono": "^4.13.16",
		"hyparquet": "^1.32.0",
		"hyparquet-compressors": "^1.1.3",
		"lucide-react": "^1.68.0",
		"motion": "^14.9.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shiki": "^4.6.0",
		"sonner": "^2.0.8",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@happy-dom/global-registrator": "^21.0.4",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/react-query-devtools": "^5.105.3",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-cli": "^1.167.46",
		"@tanstack/router-plugin": "^1.168.48",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"git-cliff": "^2.14.2",
		"hyparquet-writer": "^0.18.0",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "7",
		"vite": "^8.3.5"
	}
}
