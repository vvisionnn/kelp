# Kelp sign-in. The admin can change everything; the optional viewer is read-only.
KELP_ADMIN_USER=admin
KELP_ADMIN_PASSWORD=change-me
KELP_VIEWER_USER=
KELP_VIEWER_PASSWORD=
# Signs session cookies. Generate with: openssl rand -hex 32
KELP_SESSION_SECRET=

# Bootstrap S3 admin credentials for SeaweedFS. Create scoped users and keys in Kelp afterwards.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Shared secret between the native admin and the maintenance worker. Generate with: openssl rand -hex 32
SEAWEEDFS_WORKER_KEY=
# Public S3 URL shown in Kelp (for copy-paste snippets), e.g. https://s3.example.com
KELP_S3_ENDPOINT=

# Prometheus endpoints Kelp samples for its live charts. The compose file's default is right for
# this stack; set it only if your SeaweedFS runs elsewhere. Empty turns the charts off.
# KELP_METRICS_URLS=http://seaweedfs:9327/metrics,http://admin:9328/metrics

# Versions. Leave as-is to run the SeaweedFS version this Kelp release was tested with.
KELP_VERSION=latest
SEAWEEDFS_VERSION=4.51

# Published ports
KELP_PORT=3000
S3_PORT=8333
