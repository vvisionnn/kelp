{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun", "vite/client"],
		"jsx": "react-jsx",
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@shared/*": ["./shared/*"]
		}
	},
	"include": ["src", "server", "shared", "test", "scripts", "e2e", "vite.config.ts", "playwright.config.ts"]
}
